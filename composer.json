{
    "name": "henderjon/php-oauth1",
    "description": "A small, dependency-light OAuth 1.0 (RFC 5849) signing and verification library for PHP, with a Basic LTI 1.0/1.1 launch layer built on top.",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "henderjon"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^2.0 || ^3.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Oauth1\\": "src/Oauth1/",
            "BasicLti1\\": "src/BasicLti1/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oauth1\\": "test/Oauth1/",
            "BasicLti1\\": "test/BasicLti1/"
        }
    }
}
